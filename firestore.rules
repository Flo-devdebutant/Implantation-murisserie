rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // qui peut saisir et corriger
    function redacteur() {
      return request.auth != null && request.auth.token.email in [
        'florian@murisserie.invalid',
        'seb@murisserie.invalid',
        'sofia@murisserie.invalid'
      ];
    }

    // qui peut seulement consulter, imprimer et exporter
    function lecteur() {
      return request.auth != null && request.auth.token.email in [
        'laura@murisserie.invalid'
      ];
    }

    // un code de salle : 8 caractères, sans les signes ambigus (0, O, 1, I, L)
    function salleValide(salle) {
      return salle.matches('^[A-Z2-9]{8}$');
    }

    // un mois : AAAA-MM
    function moisValide(mois) {
      return mois.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // un mois ne peut être remplacé que par une révision strictement plus
    // récente : aucun appareil ne peut donc écraser une saisie qu'il n'a
    // pas encore vue, même après une longue coupure réseau
    function revisionEnAvance() {
      return !('rev' in resource.data) || request.resource.data.rev > resource.data.rev;
    }

    // Le document d'un mois ne contient que ce que l'application y écrit :
    // les journées (compressées ou non), un numéro de révision entier, et qui
    // l'a écrit quand. Tout autre champ est refusé.
    function contenuMoisValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['jours', 'joursZ', 'v', 'rev', 'updatedAt', 'updatedBy'])
        && d.rev is int && d.rev >= 1;
    }

    // Le document de la salle ne porte que ses réglages (jours chômés,
    // dimanches reconduits), plus les deux champs de l'ancien format, que
    // l'application efface après les avoir repris.
    function contenuSalleValide() {
      return request.resource.data.keys().hasOnly(
        ['reconduits', 'joursChomes', 'v', 'updatedAt', 'updatedBy', 'journees', 'journeesZ']);
    }

    match /murisserieRooms/{salle} {
      allow read:           if (redacteur() || lecteur()) && salleValide(salle);
      // pas de suppression : l'application n'en fait jamais
      allow create, update: if redacteur() && salleValide(salle) && contenuSalleValide();

      match /mois/{mois} {
        allow read:   if (redacteur() || lecteur()) && salleValide(salle);
        allow create: if redacteur() && salleValide(salle) && moisValide(mois) && contenuMoisValide();
        allow update: if redacteur() && salleValide(salle) && moisValide(mois) && contenuMoisValide()
                      && revisionEnAvance();
      }
    }
  }
}
